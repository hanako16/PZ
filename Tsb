        invisible          = false,
        targetKills        = 3,
        range              = 250,
        stickDist          = 4.2,
        lowHealthOnly      = true,
        lowHealthThreshold = 0.4,
        lowGraphics        = false,
    }
    pcall(function()
        if readfile and isfile and isfile(CONFIG_FILE) then
