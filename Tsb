-- ========== CHARACTER DETECTION ==========
local function detectCharacter()
    local char = LP.Character
    if not char then return "Unknown" end




    local candidates = {
        char:GetAttribute("Character"),
        char:GetAttribute("Moveset"),
        char:GetAttribute("SelectedCharacter"),
        LP:GetAttribute("Character"),
        LP:GetAttribute("SelectedCharacter"),
    }
    for _, v in ipairs(candidates) do
        if typeof(v) == "string" and v ~= "" then return v end
    end




    for _, name in ipairs({"Character", "Moveset", "SelectedCharacter", "CurrentCharacter"}) do
        local v = char:FindFirstChild(name) or LP:FindFirstChild(name)
        if v and (v:IsA("StringValue") or v:IsA("ObjectValue")) then
            local val = v.Value
            if typeof(val) == "string" and val ~= "" then return val end
            if typeof(val) == "Instance" then return val.Name end
        end
    end




    local tools = {}
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t.Name) end
    end
    if LP:FindFirstChild("Backpack") then
        for _, t in ipairs(LP.Backpack:GetChildren()) do
            if t:IsA("Tool") then table.insert(tools, t.Name) end
        end
    end
    local toolStr = table.concat(tools, " "):lower()
    if toolStr:find("consecutive") or toolStr:find("serious") or toolStr:find("normal punch") then
        return "The Strongest Hero"
    elseif toolStr:find("flowing") or toolStr:find("whirlwind") or toolStr:find("hunter") then
        return "Hero Hunter"
    elseif toolStr:find("machine gun") or toolStr:find("ignition") or toolStr:find("blitz") then
        return "Destructive Cyborg"
    elseif toolStr:find("flash") or toolStr:find("scatter") or toolStr:find("whirlwind kick") then
        return "Deadly Ninja"
    elseif toolStr:find("homerun") or toolStr:find("metal") then
        return "Brutal Demon"
    end




    pcall(function()
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, g in ipairs(pg:GetDescendants()) do
            if g:IsA("TextLabel") or g:IsA("TextButton") then
                local txt = (g.Text or ""):lower()
                for name, data in pairs(Combos) do
                    if txt:find(name:lower()) then return name end
                    for _, a in ipairs(data.aliases or {}) do
                        if txt:find(a:lower()) then return name end
                    end
                end
            end
        end
    end)




    return "Unknown"
end




local function getComboFor(name)
    if Combos[name] then return Combos[name] end
    local lower = name:lower()
    for n, data in pairs(Combos) do
        if n:lower() == lower then return data end
        for _, a in ipairs(data.aliases or {}) do
            if a:lower() == lower or lower:find(a:lower()) then return data end
        end
    end
    return DefaultCombo
end




-- ========== TARGETING ==========
local function getClosestEnemy()
    local myChar = LP.Character
    local myHRP  = getHRP(myChar)
    if not myHRP then return nil end




    local lowTarget, lowestHP    = nil, math.huge
    local anyTarget, closestDist = nil, PZ.range




    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local c   = plr.Character
        if not isAlive(c) then continue end
        local hrp  = getHRP(c)
        local hum  = getHum(c)
        local dist = (myHRP.Position - hrp.Position).Magnitude
        if dist > PZ.range then continue end




        local hpPct = hum.Health / hum.MaxHealth




        if dist < closestDist then
            closestDist = dist
            anyTarget   = {player = plr, char = c, hrp = hrp, dist = dist, hpPct = hpPct}
        end




        if hpPct <= PZ.lowHealthThreshold and hum.Health < lowestHP then
            lowestHP  = hum.Health
            lowTarget = {player = plr, char = c, hrp = hrp, dist = dist, hpPct = hpPct}
        end
    end




    if lowTarget then return lowTarget end
    if PZ.lowHealthOnly then return nil end
    return anyTarget
end




local function stickTo(target)
    local myChar = LP.Character
    local myHRP  = getHRP(myChar)
    if not myHRP or not target or not target.hrp then return end
    local look   = target.hrp.CFrame.LookVector
    local behind = target.hrp.Position - look * PZ.stickDist
    myHRP.CFrame  = CFrame.new(behind, target.hrp.Position)
end




-- ========== COMBO ENGINE ==========
local comboRunning = false
local function runCombo(comboData)
    if comboRunning then return end
    comboRunning = true
    task.spawn(function()
        local seq = comboData.sequence
        for _, step in ipairs(seq) do
            if not PZ.autofarm then break end
            if step.type == "m1" then
                for i = 1, step.count do
                    if not PZ.autofarm then break end
                    click()
                    task.wait(step.wait or 0.1)
                end
            elseif step.type == "key" then
                pressKey(step.key)
                task.wait(step.wait or 0.3)
            end
        end
        task.wait(0.15)
        if PZ.invisible then
            setInvisible(true)
        end
        comboRunning = false
    end)
end




-- ========== KILL TRACKING ==========
local lastKnownKills = 0




local function updateKills()
    local ls = LP:FindFirstChild("leaderstats")
    if not ls then return end
    local killsVal = ls:FindFirstChild("Kills")
        or ls:FindFirstChild("kills")
        or ls:FindFirstChild("Kill")
    if not killsVal then return end
    if not (killsVal:IsA("IntValue") or killsVal:IsA("NumberValue")) then return end




    local current = killsVal.Value




    if not PZ.killsSeeded then
        lastKnownKills  = current
        PZ.killsSeeded  = true
        return
    end



if current > lastKnownKills then
        local gained    = current - lastKnownKills
        PZ.kills        = PZ.kills + gained
        lastKnownKills  = current
        notify("Platinum Z", "Kill +" .. gained .. " | Session: " .. PZ.kills)
    end
end




-- ========== SERVER HOP ==========
local function serverHop()
    if tick() - PZ.lastHop < 8 then return end
    PZ.lastHop = tick()
    notify("Platinum Z", "Server hopping after " .. PZ.kills .. " session kills...")
    PZ.kills       = 0
    PZ.killsSeeded = false
    pcall(function()
        local placeId = game.PlaceId
        local servers = {}
        local req  = game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100")
        local data = HttpService:JSONDecode(req)
        if data and data.data then
            for _, s in ipairs(data.data) do
                if s.playing and s.playing < s.maxPlayers and s.id ~= game.JobId then
                    table.insert(servers, s.id)
                end
            end
        end
        if #servers > 0 then
            local pick = servers[math.random(1, #servers)]
            TS:TeleportToPlaceInstance(placeId, pick, LP)
        else
            TS:Teleport(placeId, LP)
        end
    end)
end




-- ========== MAIN LOOP ==========
local function mainLoop()
    if not PZ.autofarm then return end
    local myChar = LP.Character
    if not isAlive(myChar) then return end




    local detected = detectCharacter()
    if detected ~= "Unknown" and detected ~= PZ.currentChar then
        PZ.currentChar = detected
        notify("Platinum Z", "Character: " .. detected)
    end




    local target = getClosestEnemy()
    PZ.target = target




    if target then
        stickTo(target)
        if not comboRunning then
            runCombo(getComboFor(PZ.currentChar))
        end
    end




    if tick() - PZ.lastKillCheck > 1.2 then
        PZ.lastKillCheck = tick()
        updateKills()
        if PZ.serverhop and PZ.kills >= PZ.targetKills then
            serverHop()
        end
    end
end




PZ.conn = RS.Heartbeat:Connect(function()
    pcall(mainLoop)
end)




