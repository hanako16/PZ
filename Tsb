-- ========== LOW GRAPHICS MODE ==========
-- Stores original lighting/render values so they can be fully restored.
-- Only touches client-side render settings -- hitbox, farm logic, combo engine unaffected.
local originalGraphics = nil




local function captureOriginalGraphics()
    if originalGraphics then return end  -- only snapshot once
    originalGraphics = {
        -- Lighting properties
        Brightness          = Lighting.Brightness,
        Ambient             = Lighting.Ambient,
        OutdoorAmbient      = Lighting.OutdoorAmbient,
        FogEnd              = Lighting.FogEnd,
        FogStart            = Lighting.FogStart,
        FogColor            = Lighting.FogColor,
        GlobalShadows       = Lighting.GlobalShadows,
        -- Render quality
        QualityLevel        = settings().Rendering.QualityLevel,
        -- Effects stored for toggling
        effects             = {}
    }
    -- Snapshot all Lighting effects (Bloom, DepthOfField, etc.)
    for _, eff in ipairs(Lighting:GetChildren()) do
        if eff:IsA("PostEffect") or eff:IsA("Sky") or eff:IsA("Atmosphere") then
            table.insert(originalGraphics.effects, {
                instance = eff,
                enabled  = eff.Enabled ~= false
            })
        end
    end
end




local function applyLowGraphics()
    captureOriginalGraphics()

    -- Kill all post-processing effects (Bloom, Blur, ColorCorrection, SunRays, etc.)
    for _, eff in ipairs(Lighting:GetChildren()) do
        if eff:IsA("PostEffect") then
            eff.Enabled = false
        end
    end

    -- Flatten lighting -- reduces GPU overdraw on shadow calculations
    Lighting.Brightness     = 2
    Lighting.Ambient        = Color3.fromRGB(180, 180, 180)
    Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
    Lighting.GlobalShadows  = false

    -- Push fog far out so the renderer doesn't process distant geometry
    Lighting.FogEnd   = 100000
    Lighting.FogStart = 99000
    Lighting.FogColor = Color3.fromRGB(0, 0, 0)

    -- Drop render quality to minimum
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    -- Disable Atmosphere if present (expensive scattering pass)
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo then atmo.Enabled = false end
end




local function restoreGraphics()
    if not originalGraphics then return end

    -- Restore post-processing effects to original state
    for _, entry in ipairs(originalGraphics.effects) do
        pcall(function()
            if entry.instance and entry.instance.Parent then
                if entry.instance:IsA("PostEffect") or entry.instance:IsA("Atmosphere") then
                    entry.instance.Enabled = entry.enabled
                end
            end
        end)
    end

    -- Restore lighting
    Lighting.Brightness     = originalGraphics.Brightness
    Lighting.Ambient        = originalGraphics.Ambient
    Lighting.OutdoorAmbient = originalGraphics.OutdoorAmbient
    Lighting.FogEnd         = originalGraphics.FogEnd
    Lighting.FogStart       = originalGraphics.FogStart
    Lighting.FogColor       = originalGraphics.FogColor
    Lighting.GlobalShadows  = originalGraphics.GlobalShadows

    -- Restore render quality
    pcall(function()
        settings().Rendering.QualityLevel = originalGraphics.QualityLevel
    end)
end




